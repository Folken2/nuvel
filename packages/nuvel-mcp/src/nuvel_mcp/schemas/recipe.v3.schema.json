{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nuvel.recipe/3",
  "description": "One shared recipe. Structure is required and closed: category, steps (an action, a tool kind and placeholder slots each) and usage stats. Free text is optional and lives only under 'text' (title, when_to_use, step_notes, pitfalls, narrative); the server masks it with a per-language allowlist before anything is stored, relayed or logged. Closed at every level. 'tenant' and 'masking' are stamped by the server and rejected from clients.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "nuvel.recipe/3"
    },
    "recipe_id": {
      "type": "string",
      "format": "uuid"
    },
    "install_id": {
      "type": "string",
      "format": "uuid"
    },
    "plugin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "chief-of-staff"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d{1,2}\\.\\d{1,2}\\.\\d{1,2}$"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "category": {
      "type": "string",
      "enum": [
        "client-proposal",
        "client-onboarding",
        "client-followup",
        "meeting-prep",
        "meeting-followup",
        "sales-pipeline",
        "partner-relations",
        "investor-update",
        "board-meeting",
        "monthly-close",
        "invoicing",
        "budget-planning",
        "hiring",
        "team-management",
        "reporting",
        "contract-review",
        "travel-planning",
        "event-planning",
        "inbox-triage",
        "document-drafting",
        "research",
        "weekly-planning",
        "other"
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search",
              "read",
              "summarise",
              "extract",
              "compare",
              "check",
              "calculate",
              "list",
              "draft",
              "edit",
              "translate",
              "create",
              "update",
              "file",
              "propose_slot",
              "schedule",
              "send",
              "reply",
              "forward",
              "share",
              "remind",
              "follow_up",
              "ask",
              "decide",
              "wait",
              "other"
            ]
          },
          "tool_kind": {
            "type": "string",
            "enum": [
              "email",
              "calendar",
              "chat",
              "docs",
              "storage",
              "tasks",
              "web",
              "none"
            ]
          },
          "slots": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "person",
                "company",
                "team",
                "product",
                "project",
                "document",
                "file",
                "folder",
                "amount",
                "number",
                "date",
                "time",
                "period",
                "place",
                "email",
                "phone",
                "url",
                "id",
                "topic",
                "other"
              ]
            }
          }
        },
        "required": [
          "action",
          "tool_kind",
          "slots"
        ],
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "uses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "successes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "corrections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "days_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "uses",
        "successes",
        "corrections",
        "days_used"
      ],
      "additionalProperties": false
    },
    "text": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "title": {
          "type": "string",
          "maxLength": 80
        },
        "when_to_use": {
          "type": "string",
          "maxLength": 200
        },
        "step_notes": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "pitfalls": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "narrative": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "language"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "recipe_id",
    "install_id",
    "plugin",
    "version",
    "category",
    "steps",
    "stats"
  ],
  "additionalProperties": false
}
