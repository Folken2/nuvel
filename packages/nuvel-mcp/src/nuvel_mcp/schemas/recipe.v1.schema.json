{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nuvel.recipe/1",
  "description": "One anonymised, generic recipe. Closed at every level. 'tenant' is stamped by the server and rejected from clients; text fields are also screened for PII server-side.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "nuvel.recipe/1"
    },
    "recipe_id": {
      "type": "string",
      "format": "uuid"
    },
    "install_id": {
      "type": "string",
      "format": "uuid"
    },
    "plugin": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "when_to_use": {
      "type": "string",
      "maxLength": 200
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
          },
          "tool_kind": {
            "type": "string",
            "enum": [
              "email",
              "calendar",
              "chat",
              "docs",
              "storage",
              "tasks",
              "web",
              "none"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "action",
          "tool_kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "pitfalls": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    }
  },
  "required": [
    "schema",
    "recipe_id",
    "install_id",
    "plugin",
    "version",
    "category",
    "language",
    "title",
    "when_to_use",
    "steps"
  ],
  "additionalProperties": false
}
