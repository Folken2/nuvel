# ── {{agent_name}} — API keys ──────────────────────────────────────────
# Copy to .env next to this profile, or export these in the environment
# Hermes itself runs under. Behaviour lives in config.yaml; only secrets
# belong here.

# ── Model provider ───────────────────────────────────────────────────

# Key for the provider named by `model.provider` in config.yaml.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Other providers, if you switch `model.provider`:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Optional: any OpenAI-compatible endpoint (self-hosted, gateway, vLLM).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Telegram gateway ─────────────────────────────────────────────────
# Only needed when platforms.telegram.enabled is true in config.yaml
# (scaffold with --with-telegram to get that wired up front).

# From @BotFather. Treat it as a password: it *is* the bot.
TELEGRAM_BOT_TOKEN={{telegram_bot_token}}

# ── Runtime ──────────────────────────────────────────────────────────

# Optional: override where Hermes keeps profiles (default: ~/.hermes).
# HERMES_HOME=

# Optional: DEBUG | INFO | WARNING (default) | ERROR.
# LOG_LEVEL=WARNING
