"""
{{agent_name}} — generated by meta-agent.
"""

from __future__ import annotations

import logging
from typing import Optional

from dotenv import load_dotenv
from google.adk.agents import LlmAgent
from google.adk.skills import load_skill_from_dir
from google.adk.tools.base_toolset import BaseToolset
from google.adk.tools.skill_toolset import SkillToolset

from .config.llm import FAST_MODEL
from .config.paths import skills_dir
from .config.seed import seed_volume_if_empty
from .guardrails.command_guard import command_guard_callback
from .guardrails.exfil_guard import exfil_guard
from .memory.review_fork import review_fork_callback
from .tools import get_tools
from .prompt.instructions import get_agent_instruction

logger = logging.getLogger(__name__)

load_dotenv()

# First-boot: copy in-repo seeds into runtime paths if they're empty
# (no-op locally; populates a deployment volume on first deploy).
seed_volume_if_empty()


class LazySkillToolset(BaseToolset):
    """SkillToolset wrapper that rebuilds when SKILL.md files change.

    Detects mtime changes under SKILLS_DIR on every get_tools() call and
    rebuilds the underlying SkillToolset if anything was added/changed/removed.
    Lets the agent self-author skills (via author_skill, when --persona is on)
    that become queryable on the *next* invocation — no process restart.

    Not redundant with google-adk 2.10's native "notice that a loaded skill has
    changed". Verified against google-adk 2.10.0; pinned by
    tests/test_skill_hot_reload.py in the nuvel repo. Line numbers below are in
    ``google/adk/tools/skill_toolset.py`` unless noted:

    - ``SkillToolset.get_tools()`` (:1879) never touches the filesystem. The
      catalog is frozen into ``self._skills`` at construction (:1790) and
      ``_list_skills()`` (:2010) just returns it, so a toolset built once and
      reused — this agent's pattern — never sees a skill directory that was
      added, edited or deleted afterwards.
    - The native change detection is ``_restate_changed_skills`` (:2394), gated
      on ``SkillLifecycleConfig.revalidate_skills``, which defaults to False
      (:168, applied at :1776). It only re-states skills the model has already
      loaded, and resolves them through ``_get_or_fetch_skill`` (:1968), which
      returns the in-memory copy before consulting a registry (:1976). With no
      registry — our case — it compares in-memory against in-memory and can
      never fire. It is a registry-freshness check, not a disk watcher.
    - The surrounding lifecycle surface (``unload_skill`` et al.) requires the
      experimental ``ADK_ENABLE_SKILL_LIFECYCLE=1`` flag
      (``google/adk/features/_feature_registry.py``:209, ``default_on=False``).
      A generated agent must not depend on an experimental flag.

    Known gap, accepted: the scan covers SKILL.md mtimes plus the top-level
    skills dir mtime, so add/edit/remove of a skill is caught but editing only a
    skill's ``references/`` or ``scripts/`` file is not. Touch its SKILL.md to
    force a rebuild.

    Two consequences of wrapping rather than subclassing ``SkillToolset``, both
    verified against google-adk 2.10.0 and pinned by
    tests/test_skill_discovery_mode.py in the nuvel repo:

    - ``process_llm_request`` must be forwarded explicitly. The flow calls it on
      whatever sits in ``agent.tools``
      (``google/adk/flows/llm_flows/tools/_agent_tools.py``:107-112), which is
      this wrapper, and ``BaseToolset.process_llm_request``
      (``google/adk/tools/base_toolset.py``:231-246) is a no-op. Without the
      override below the model gets the skill *tools* but none of the skill
      *guidance* (~1.8k chars telling it to call ``load_skill`` at all).
    - ``_rebuild_if_needed`` constructs a fresh default-configured
      ``SkillToolset``, so any non-default constructor argument has to be set
      there to survive a rebuild. Today there are none: ``discovery_mode``
      defaults to ``SkillDiscoveryMode.LAZY`` (:1730), which is already the
      on-demand disclosure this agent wants — the catalog stays out of the
      system instruction and reaches the model only when it calls
      ``list_skills``. ``EAGER`` is the opposite trade and measured ~7k chars
      (~1.8k tokens) more per request for our 15-skill catalog.
    """

    def __init__(self) -> None:
        super().__init__()
        self._mtime: float = -1.0
        self._inner: Optional[SkillToolset] = None

    def _scan_mtime(self) -> float:
        d = skills_dir()
        if not d.is_dir():
            return 0.0
        latest = d.stat().st_mtime
        for p in d.rglob("SKILL.md"):
            try:
                latest = max(latest, p.stat().st_mtime)
            except OSError:
                continue
        return latest

    def _rebuild_if_needed(self) -> None:
        cur = self._scan_mtime()
        if cur == self._mtime and self._inner is not None:
            return
        d = skills_dir()
        skills = []
        if d.is_dir():
            for skill_dir in sorted(d.iterdir()):
                if skill_dir.is_dir() and (skill_dir / "SKILL.md").exists():
                    try:
                        skills.append(load_skill_from_dir(skill_dir))
                    except Exception as e:
                        logger.warning("Skip skill %s: %s", skill_dir.name, e)
        self._inner = SkillToolset(skills=skills) if skills else None
        self._mtime = cur
        logger.info("Skill toolset rebuilt: %d skills", len(skills))

    async def get_tools(self, readonly_context=None):
        self._rebuild_if_needed()
        if self._inner is None:
            return []
        return await self._inner.get_tools(readonly_context)

    async def process_llm_request(self, *, tool_context, llm_request):
        """Forwards to the inner toolset so skill guidance reaches the model.

        ``BaseToolset``'s implementation is a no-op, and the flow calls this on
        the wrapper, not on the inner toolset. See the class docstring.
        """
        self._rebuild_if_needed()
        if self._inner is None:
            return
        await self._inner.process_llm_request(
            tool_context=tool_context, llm_request=llm_request
        )

    async def close(self):
        if self._inner is not None:
            await self._inner.close()


def _build_tools():
    tools = list(get_tools())
    tools.append(LazySkillToolset())
    return tools


root_agent = LlmAgent(
    model=FAST_MODEL,
    name="{{agent_name_snake}}",
    description="{{agent_description}}",
    instruction=get_agent_instruction,
    tools=_build_tools(),
    before_tool_callback=[exfil_guard, command_guard_callback],
    # Fire-and-forget memory self-improvement judge (opt-in via
    # NUVEL_MEMORY_REVIEW_FORK=1). Never blocks the reply; the judge runs on
    # the SiblingRunner plugin and has no after_agent chain of its own.
    after_agent_callback=[review_fork_callback],
)
