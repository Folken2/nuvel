"""
{{agent_name}} — workflow-native root agent (generated by meta-agent).

The root agent here is an ADK 2.0 `Workflow` graph rather than a single
`LlmAgent`. The graph is deliberately small — it exists to show the three
things you need for real orchestration:

    1. Nodes that are `LlmAgent`s with an explicit delegation `mode`.
    2. Typed contracts between them (`output_schema` on every node that
       hands data onward).
    3. A deterministic routing step between the planning and execution
       nodes.

Load the `adk-task-delegation` and `adk-workflow-graphs` skills for the
full API. To go back to a single-agent shape, replace `root_agent` with a
plain `LlmAgent` — nothing else in the project assumes a graph.
"""

from __future__ import annotations

import logging
from typing import Literal

from dotenv import load_dotenv
from google.adk import Event
from google.adk.agents import LlmAgent
from google.adk.workflow import Workflow, node
from pydantic import BaseModel, Field

from .config.llm import FAST_MODEL, REASONING_MODEL
from .config.seed import seed_volume_if_empty
from .tools import get_tools

logger = logging.getLogger(__name__)

load_dotenv()

# First-boot: copy in-repo seeds into runtime paths if they're empty
# (no-op locally; populates a deployment volume on first deploy).
seed_volume_if_empty()


# ── Typed contracts ──────────────────────────────────────────────────
# Every node that hands data to another node declares an output_schema.
# For a mode='task' agent the schema also becomes the parameter list of
# the auto-attached `finish_task` tool, so the agent cannot finish
# without producing schema-valid output.


class Plan(BaseModel):
    """What the planning node produces."""

    goal: str = Field(description="The user's request, restated concretely.")
    steps: list[str] = Field(description="Ordered steps that satisfy the goal.")
    feasible: bool = Field(
        description="False when the request cannot be met with the available tools."
    )
    reason: str = Field(
        default="",
        description="Why the request is infeasible. Empty when feasible.",
    )


class Outcome(BaseModel):
    """What the execution node produces."""

    completed: list[str] = Field(description="Steps that were carried out.")
    skipped: list[str] = Field(default_factory=list)
    answer: str = Field(description="The final answer for the user.")


# ── Nodes ────────────────────────────────────────────────────────────


planner = LlmAgent(
    model=REASONING_MODEL,
    name="planner",
    description="Turns the user's request into an ordered, checkable plan.",
    instruction=(
        "You are the planning stage of {{agent_name}}.\n\n"
        "Restate the user's request as a concrete goal and break it into "
        "ordered steps that the execution stage can carry out with its tools. "
        "If the request is ambiguous, ask the user before planning. "
        "If it cannot be done with the available tools, set feasible=false "
        "and explain why in `reason`.\n\n"
        "Call finish_task once the plan is complete."
    ),
    # mode='task': the planner may come back to the user for clarification,
    # and finishes by calling the auto-attached finish_task tool.
    mode="task",
    output_schema=Plan,
)


executor = LlmAgent(
    model=FAST_MODEL,
    name="executor",
    description="Executes a plan and reports what was done.",
    instruction=(
        "You are the execution stage of {{agent_name}}.\n\n"
        "You receive a plan. Work through its steps in order using your "
        "tools. Ask the user before doing anything destructive or "
        "irreversible. Record each step under `completed` or `skipped`, and "
        "put the user-facing result in `answer`.\n\n"
        "Call finish_task once every step is done or explicitly skipped."
    ),
    mode="task",
    output_schema=Outcome,
    tools=list(get_tools()),
)


decline = LlmAgent(
    model=FAST_MODEL,
    name="decline",
    description="Explains why the request cannot be fulfilled.",
    instruction=(
        "The plan was marked infeasible. Tell the user plainly what cannot "
        "be done and why, and suggest the closest thing that can be. "
        "Do not attempt the work."
    ),
    # mode='single_turn': one bounded response, no tools, no follow-up turns.
    mode="single_turn",
    output_schema=Outcome,
)


# ── Routing ──────────────────────────────────────────────────────────
# Routes must be deterministic, so the branch is decided by a plain
# function node reading the planner's typed output — never by routing on
# free-form model text.


@node
def route_plan(node_input: Plan) -> Event:
    """Send feasible plans to the executor, everything else to `decline`."""
    route: Literal["execute", "decline"] = (
        "execute" if node_input.feasible and node_input.steps else "decline"
    )
    logger.info("route_plan: %s (%d steps)", route, len(node_input.steps))
    return Event(output=node_input, route=route)


# ── The graph ────────────────────────────────────────────────────────
# A node's output becomes the next node's `node_input`: the planner's
# validated `Plan` flows into route_plan, and on to whichever branch it
# selects.


root_agent = Workflow(
    name="{{agent_name_snake}}",
    description="{{agent_description}}",
    edges=[
        ("START", planner),
        (planner, route_plan),
        (
            route_plan,
            # `decline` is the __DEFAULT__ branch rather than a named one:
            # graph validation rejects two edges between the same pair of
            # nodes, so a route key and __DEFAULT__ can't share a target.
            {
                "execute": executor,
                "__DEFAULT__": decline,
            },
        ),
    ],
)


# ── Runner construction ──────────────────────────────────────────────
# AgentHarness is the single place session/artifact services and the
# plugin chain are wired. A Workflow is a BaseNode, so it drops into
# build_runner() exactly like an LlmAgent would.


def build_runner():
    """Build a Runner for this workflow with the project's plugin chain."""
    from .harness import AgentHarness

    return AgentHarness.get("{{agent_name}}").build_runner(agent=root_agent)
