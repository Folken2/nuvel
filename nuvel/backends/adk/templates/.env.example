# ── Agent — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your actual values

# ── Mode ─────────────────────────────────────────────────────────────

# Development Mode: in-memory session storage (no database required)
DEV_MODE=true

# Optional: Port for ADK server (defaults to 8000)
PORT=8000

# Optional: Directory containing agent definitions (defaults to current directory)
AGENTS_DIR=.

# ── Database (Production) ──────────────────────────────────────────

# Required in PRODUCTION (DEV_MODE=false): Postgres for ADK session storage
# SESSION_SERVICE_URI=postgresql://user:password@host/database?sslmode=require

# ── Artifacts ────────────────────────────────────────────────────────
# Artifacts (files the agent saves/loads via tool_context.save_artifact) are
# versioned by AgentHarness (harness.py). Storage backend is chosen in this
# order: ARTIFACT_SERVICE_URI, then DEV_MODE (in-memory), then
# ARTIFACT_STORAGE_DIR.

# Optional: explicit artifact backend. One of:
#   memory://                 in-memory (dev/test only, not persisted)
#   file:///abs/path           local disk
#   gs://bucket-name            Google Cloud Storage
# ARTIFACT_SERVICE_URI=file:///data/artifacts

# Optional: disk root for file-backed artifacts in PRODUCTION when
# ARTIFACT_SERVICE_URI is unset (default: /data/artifacts). Ignored if
# ARTIFACT_SERVICE_URI is set.
# ARTIFACT_STORAGE_DIR=/data/artifacts

# ── LLM ──────────────────────────────────────────────────────────────

# Required: OpenRouter API key for LLM access
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override default models
# FAST_MODEL={{default_fast_model}}
# REASONING_MODEL={{default_reasoning_model}}

# Optional: OpenRouter attribution headers (default: this agent's name).
# OPENROUTER_REFERER=https://github.com/your-org/{{agent_name}}
# OPENROUTER_TITLE={{agent_name}}

{{composio_env_block}}{{gateway_env_block}}{{acp_env_block}}# ── Security ─────────────────────────────────────────────────────────

# Recommended: API key for endpoint authentication
# When set, all endpoints except /health require Bearer token or X-API-Key header
# API_KEY=your_secret_api_key_here

# Optional: Enable Swagger/OpenAPI docs in production (disabled by default when API_KEY is set)
# DOCS_ENABLED=false

# ── Resilience ───────────────────────────────────────────────────────

# Optional: Rate limiting for tool calls (token bucket)
# TOOL_RATE_LIMIT=5.0    # requests per second
# TOOL_RATE_BURST=20     # burst capacity

# Optional: Comma-separated list of tools protected by the circuit breaker
# PROTECTED_TOOLS=

# ── Logging ──────────────────────────────────────────────────────────

# Optional: Log format — "json" for production (structured), "text" for dev (colored)
# LOG_FORMAT=text
# LOG_LEVEL=INFO

# Optional: Context filter — number of prior invocations to keep in context window
# CONTEXT_FILTER_KEEP=10

# ── Long-Term Memory ────────────────────────────────────────────────

# Optional: Enable/disable long-term memory (default: true)
# MEMORY_ENABLED=true

# Optional: Max size for core memory file in characters (default: 10000)
# MEMORY_MAX_CORE_SIZE=10000

# Optional: Max size per topic file in characters (default: 5000)
# MEMORY_MAX_TOPIC_SIZE=5000

# ── Memory self-improvement judge fork (opt-in, default off) ─────────
# After each turn a throwaway "judge" agent (cheap FAST_MODEL) can review
# the conversation fire-and-forget and write durable facts to memory. It
# never blocks the reply and is disabled unless explicitly turned on.
# NUVEL_MEMORY_REVIEW_FORK=1              # enable the judge fork (default off)
# NUVEL_MEMORY_FORK_COOLDOWN=120          # min seconds between runs (0=off)
# NUVEL_MEMORY_FORK_CAP=50                # max judge runs per session
# NUVEL_MEMORY_SIBLING_DRAIN_TIMEOUT=4.0  # shutdown drain budget (<5s)

# ── Relevance-conditioned memory preload ────────────────────────────
# Instead of pasting every memory into the prompt each turn, only the
# chunks relevant to the current query are retrieved and injected. On by
# default. Set NUVEL_MEMORY_PRELOAD=0 to fall back to whole-file injection.
# NUVEL_MEMORY_PRELOAD=1                  # enable relevance preload (default on)
# NUVEL_MEMORY_PRELOAD_TOP_K=5            # max memory chunks injected per turn
#
# ── Periodic memory consolidation ("dream" pass) ────────────────────
# Opt-in background job: dedupes exact + near-duplicate memories (cosine),
# reconciles contradictions (newest wins, conflicts flagged), and distils a
# compact structured ## User Profile block loaded back into the session tier.
# Store-agnostic (works with or without NUVEL_ORG_MEMORY_DSN); a no-op unless
# enabled. Runs off Nuvel's own scheduler — not Cloud Scheduler.
# NUVEL_MEMORY_CONSOLIDATION=1            # enable the dream pass (default off)
# NUVEL_MEMORY_CONSOLIDATION_INTERVAL=86400   # seconds between passes (default daily)
# NUVEL_MEMORY_CONSOLIDATION_SIM=0.92    # cosine threshold for near-dupe collapse
#
# Optional org-scoped memory DB. When NUVEL_ORG_MEMORY_DSN is set (and the
# nuvel org-memory extra is installed), OrgMemoryService becomes the default
# embedding-ranked backend the preload retrieves through; unset = markdown.
# NUVEL_ORG_MEMORY_DSN=postgresql://user:pass@host:5432/memory
# NUVEL_ORG_GRAPH_PATH=/data/memory/org_graph.json

# ── Writable surfaces (deployment volume) ───────────────────────────
# When deploying with a persistent volume (Railway / Fly / Render), mount
# it (e.g. /data) and point these env vars at it. Locally, leave unset to
# use the in-repo paths. seed_volume_if_empty() runs at agent boot and
# copies the in-repo seeds into the volume on first deploy.
#
# SOUL_FILE=/data/soul/SOUL.md
# AWAKENING_FILE=/data/soul/AWAKENING.md
# SKILLS_DIR=/data/skills
# MEMORY_DIR=/data/memory
#
# For clean local separation between seed (committed) and runtime state,
# point them at a gitignored .runtime/ directory:
# SOUL_FILE=./.runtime/soul/SOUL.md
# SKILLS_DIR=./.runtime/skills
# MEMORY_DIR=./.runtime/memory

# ── Observability / Traces ───────────────────────────────────────────

# Optional: Full agent traces for prompt optimization and evals
# TRACE_ENABLED=true       # set to "false" to disable all tracing
# TRACE_DIR=./traces       # directory for JSONL trace files (always written)
# TRACE_DB=false           # set to "true" to also write traces to PostgreSQL (agent_traces table)

# Per-field truncation caps (characters). Tool args default high so the
# full agent input is captured for schema auditing.
# TRACE_MAX_ARGS_CHARS=50000
# TRACE_MAX_RESULT_CHARS=10000
# TRACE_MAX_RESPONSE_CHARS=10000
# TRACE_MAX_THINKING_CHARS=10000
# TRACE_MAX_SYSTEM_INSTR_CHARS=50000
# TRACE_MAX_ERROR_CHARS=2000

# ── Cost Guard ──────────────────────────────────────────────────────

# Optional: Per-session cost budget in USD (0 = no limit)
# COST_GUARD_BUDGET=0.50

# Optional: Path to custom pricing.json (default: bundled with plugins)
# COST_GUARD_PRICING=./pricing.json

# ── Context Window ──────────────────────────────────────────────────

# The ContextWindowPlugin reports how full the model's context window is
# after each response (published to session state as `context_window`),
# so a frontend can show a live "context used" indicator.

# Optional: Path to custom context_windows.json (default: bundled with plugins)
# CONTEXT_WINDOW_CONFIG=./context_windows.json

# Optional: Fallback window size (tokens) for models not in the config.
# 0 = unknown -> percentages are omitted for unknown models.
# CONTEXT_WINDOW_DEFAULT=0

# Optional: Log a one-time warning once usage crosses this percent (0 = off).
# CONTEXT_WINDOW_WARN_PCT=80

# ── Cron scheduling ─────────────────────────────────────────────────

# Optional: enable the background tick loop that runs scheduled prompts.
# When unset, /cron HTTP routes and the cronjob tool still work — only
# the automatic execution is disabled.
# NUVEL_CRON_ENABLED=1

# Optional: tick interval in seconds (default 60).
# NUVEL_CRON_TICK_SECONDS=60

# Optional: storage directory for jobs.json + run outputs (default ~/.nuvel/cron).
# NUVEL_CRON_DIR=~/.nuvel/cron

# ── Cron isolation hardening (opt-in) ───────────────────────────────

# Scoped secrets: when enabled, a job that declares a `secrets` list sees ONLY
# those env vars while it runs (blast-radius boundary). Jobs without a declared
# list keep seeing the full environment (back-compat). Default off.
# NUVEL_CRON_SCOPE_SECRETS=1

# Headless approval policy for tools called during a scheduled (unattended) run:
#   allow-shell (default) — shell/bin tools run in the isolated scope and are
#                           allowed; every other tool is auto-denied.
#   deny-all              — deny every tool.
#   allow-all             — allow every tool (opt out of the gate).
# NUVEL_CRON_HEADLESS_POLICY=allow-shell

# Optional: override which tool names count as "shell/bin" (comma-separated).
# NUVEL_CRON_SHELL_TOOLS=shell,bash,run_command

# HITL-gated creation: when enabled, new jobs land as `pending` and only start
# ticking after a human confirms (`/cron confirm <id>` or the cronjob tool's
# `confirm` action). Default off — set to 1 to require confirmation.
# NUVEL_CRON_HITL_CREATE=1

# ── Streaming / Voice Agent ─────────────────────────────────────────

# Optional: Enable bidirectional streaming (voice/video) via Gemini Live API
# Requires GOOGLE_API_KEY. Uses WebSocket at /ws/{user_id}/{session_id}
# STREAMING_ENABLED=false

# Required when STREAMING_ENABLED=true: Google API key for Gemini Live API
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: Gemini model for live streaming (must support Live API)
# LIVE_MODEL=gemini-2.0-flash-live-001
