# ── LiteLLM Gateway — Environment Variables ─────────────────────────
# `nuvel agent create --with-litellm` already wrote a .env next to this
# file (gitignored) with a freshly generated LITELLM_MASTER_KEY. Fill in
# the remaining values there. Never commit .env.

# ── LiteLLM Core ────────────────────────────────────────────────────
# Admin key for the proxy (config.yaml reads os.environ/LITELLM_MASTER_KEY).
# Must start with "sk-". Generate one with:
#   python -c 'import secrets; print("sk-" + secrets.token_urlsafe(32))'
LITELLM_MASTER_KEY=

# ── Database for virtual keys ───────────────────────────────────────
# Postgres connection string. If using the bundled docker-compose.yaml
# Postgres sidecar, the default below Just Works. To point at Neon or
# another external Postgres, replace it.
LITELLM_DATABASE_URL=postgresql://litellm:litellm@postgres:5432/litellm

# ── OpenRouter API key (default routing) ─────────────────────────────
# LiteLLM routes all model calls through OpenRouter by default.
# This is the only key you need to get started — OpenRouter handles
# provider fallbacks, redundancy, and billing.
OPENROUTER_API_KEY=your_openrouter_api_key_here
#
# ── Direct provider keys (optional, for bypassing OpenRouter) ───────
# Uncomment the entries in config.yaml and add the corresponding keys:
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenTelemetry ───────────────────────────────────────────────────
# LiteLLM ships OTel traces to any OTLP-compatible backend (Jaeger,
# Grafana Cloud, Honeycomb, Datadog, etc.).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=

# ── Agent connection ────────────────────────────────────────────────
# The agent connects to LiteLLM at this base URL (set these on the
# agent side, not here):
#   LITELLM_BASE_URL=http://localhost:4000/v1
#   LITELLM_API_KEY=$LITELLM_MASTER_KEY  (or a scoped virtual key)