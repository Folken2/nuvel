# Required: Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_key_here

# Model configuration
# CLAUDE_MODEL=claude-sonnet-4-5
# CLAUDE_FALLBACK_MODEL=claude-haiku-4-5

# Permissions — default | acceptEdits | plan | bypassPermissions | dontAsk | auto
# PERMISSION_MODE=acceptEdits

# Limits — built into the SDK
# MAX_TURNS=20
# MAX_BUDGET_USD=1.0

# Server
# PORT=8000
# API_KEY=set_this_to_require_bearer_auth_on_run_sse

# Tracing
# TRACE_ENABLED=true
# TRACE_DIR=./traces

# Logging
# LOG_LEVEL=INFO
