# ── {{agent_name}} — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your actual values. A Buzz agent is
# configured entirely from the environment; there is no config file.

# ── Model ────────────────────────────────────────────────────────────

# Provider. One of: openrouter (default), openai, anthropic, groq, together,
# ollama. Anything else needs BUZZ_AGENT_BASE_URL + BUZZ_AGENT_API_KEY.
BUZZ_AGENT_PROVIDER=openrouter

# Model id. The provider prefix is optional and stripped when it matches
# BUZZ_AGENT_PROVIDER, so "openrouter/{{default_model}}" and
# "{{default_model}}" both work.
BUZZ_AGENT_MODEL={{default_model}}

# Required: API key for the provider above. The provider's own key env is
# also honored (OPENROUTER_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, …).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: point at any OpenAI-compatible endpoint (self-hosted, gateway, …).
# BUZZ_AGENT_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the system instruction baked in at scaffold time.
# BUZZ_AGENT_INSTRUCTION=You are a helpful assistant.

# Optional: how many model↔tool round trips one turn may take (default: 8).
# BUZZ_AGENT_MAX_TOOL_ITERATIONS=8

# Optional: per-request timeout in seconds (default: 120).
# BUZZ_AGENT_TIMEOUT=120

# ── Skills ───────────────────────────────────────────────────────────

# Optional: load skills from somewhere other than {{agent_package}}/skills/.
# BUZZ_SKILLS_DIR=./skills

# ── Buzz relay (Nostr) ───────────────────────────────────────────────

# Required to run the relay worker (python -m {{agent_package}}.buzz_relay):
# the WebSocket URL of the Buzz relay to join.
BUZZ_RELAY_URL={{buzz_relay_url}}

# Required: the NIP-29 group id this agent participates in.
BUZZ_GROUP_ID=

# The agent's Nostr identity — a 32-byte secret key, hex or nsec1….
# Leave unset and the agent generates one on first run and persists it to
# NOSTR_KEY_FILE (keep that file out of version control; .gitignore covers
# the default path).
NOSTR_PRIVATE_KEY={{nostr_private_key}}
# NOSTR_KEY_FILE=.nostr/identity.json

# Optional: reply policy in group chat. One of:
#   mention  only when the agent's npub or handle is mentioned (default)
#   all      every message in the group
# BUZZ_REPLY_POLICY=mention

# Optional: human-readable handle used for mention detection and the
# published profile (default: the agent name).
# BUZZ_AGENT_HANDLE={{agent_name}}

# ── Runtime ──────────────────────────────────────────────────────────

# Optional: user id the ACP adapter and CLI attribute sessions to.
# ACP_USER_ID=acp-user

# Optional: DEBUG | INFO | WARNING (default) | ERROR. Logs go to stderr —
# stdout is reserved for the ACP JSON-RPC stream.
# LOG_LEVEL=WARNING
